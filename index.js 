import express from 'express';
import fs from 'fs';
import path from 'path';
import pino from 'pino';
import { fileURLToPath } from 'url';

import pkg from '@whiskeysockets/baileys';
const {
  default: makeWASocket,
  useMultiFileAuthState,
  DisconnectReason
} = pkg;

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();

app.set('trust proxy', 1);
app.use(express.json({ limit: '20kb' }));

const PORT = process.env.PORT || 10000;

// Session persistante
const SESSION_DIR = process.env.SESSION_PATH ||
  path.join(__dirname, 'sessions');

fs.mkdirSync(SESSION_DIR, { recursive: true });

let socket = null;
let authState = null;
let starting = null;
let botStatus = 'starting';
let reconnectTimer = null;

const pairingAttempts = new Map();
const logger = pino({ level: 'silent' });

const sleep = ms =>
  new Promise(resolve => setTimeout(resolve, ms));

// ===============================
// WHATSAPP CONNECTION
// ===============================

async function startWhatsApp() {
  if (starting) return starting;
  if (socket) return socket;

  starting = (async () => {
    try {
      botStatus = 'connecting';

      const { state, saveCreds } =
        await useMultiFileAuthState(SESSION_DIR);

      authState = state;

      const sock = makeWASocket({
        auth: state,
        logger,
        printQRInTerminal: false,
        browser: ['Ubuntu', 'Chrome', '20.0.04'],
        connectTimeoutMs: 60000,
        defaultQueryTimeoutMs: 60000,
        keepAliveIntervalMs: 30000,
        markOnlineOnConnect: false,
        syncFullHistory: false
      });

      socket = sock;

      sock.ev.on('creds.update', saveCreds);

      sock.ev.on('connection.update', async update => {
        const { connection, lastDisconnect } = update;

        if (connection === 'open') {
          botStatus = 'connected';
          console.log('KAYSEUR MDX connecté à WhatsApp');
        }

        if (connection === 'connecting') {
          botStatus = 'connecting';
        }

        if (connection === 'close') {
          const code =
            lastDisconnect?.error?.output?.statusCode;

          socket = null;

          if (code === DisconnectReason.loggedOut) {
            botStatus = 'logged_out';
            console.log('Session WhatsApp déconnectée.');
            return;
          }

          botStatus = 'reconnecting';
          console.log('Reconnexion WhatsApp...');

          if (reconnectTimer) clearTimeout(reconnectTimer);

          reconnectTimer = setTimeout(() => {
            startWhatsApp().catch(console.error);
          }, 5000);
        }
      });

      return sock;

    } catch (error) {
      socket = null;
      botStatus = 'error';
      console.error('Erreur WhatsApp:', error.message);
      throw error;

    } finally {
      starting = null;
    }
  })();

  return starting;
}

