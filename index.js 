// ===============================
// HEALTH CHECK FOR RENDER
// ===============================

app.get('/health', (req, res) => {
  res.json({
    success: true,
    server: 'online',
    bot: botStatus
  });
});

// ===============================
// BOT STATUS
// ===============================

app.get('/status', (req, res) => {
  res.json({
    bot: 'KAYSEUR MDX',
    status: botStatus,
    connected: botStatus === 'connected',
    pairingRequired:
      authState ? !authState.creds.registered : true
  });
});

// ===============================
// WHATSAPP PAIRING CODE
// ===============================

app.post('/pair', async (req, res) => {
  try {
    let { phoneNumber } = req.body || {};

    if (!phoneNumber) {
      return res.status(400).json({
        success: false,
        message: 'Entre ton numéro WhatsApp.'
      });
    }

    phoneNumber = String(phoneNumber).replace(/\D/g, '');

    if (!/^\d{8,15}$/.test(phoneNumber)) {
      return res.status(400).json({
        success: false,
        message: 'Numéro de téléphone invalide.'
      });
    }

    if (authState?.creds?.registered) {
      return res.json({
        success: true,
        message: 'WhatsApp est déjà connecté.'
      });
    }

    const ip = req.ip;
    const now = Date.now();
    const previous = pairingAttempts.get(ip);

    if (previous && now - previous < 60000) {
      return res.status(429).json({
        success: false,
        message: 'Attends une minute avant de demander un autre code.'
      });
    }

    pairingAttempts.set(ip, now);

    if (!socket) {
      await startWhatsApp();
    }

    await sleep(2500);

    if (!socket || !authState) {
      throw new Error('Connexion WhatsApp indisponible.');
    }

    if (authState.creds.registered) {
      return res.json({
        success: true,
        message: 'WhatsApp est déjà connecté.'
      });
    }

    const code = await socket.requestPairingCode(phoneNumber);

    console.log('Nouveau code de pairing généré.');

    return res.json({
      success: true,
      bot: 'KAYSEUR MDX',
      pairingCode: code,
      message: 'Entre ce code dans WhatsApp.'
    });

  } catch (error) {
    console.error('Pairing error:', error.message);

    return res.status(500).json({
      success: false,
      message: 'Impossible de générer le code.',
      error: error.message
    });
  }
});

// ===============================
// SERVER START
// ===============================

app.listen(PORT, '0.0.0.0', () => {
  console.log('KAYSEUR MDX SERVER STARTED');
  console.log('PORT:', PORT);

  startWhatsApp().catch(error => {
    console.error('Initialisation WhatsApp:', error.message);
  });
});
